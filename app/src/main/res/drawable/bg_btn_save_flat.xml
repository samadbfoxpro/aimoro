<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <!-- حالت غیرفعال (وقتی عکس و پرامپت خالی است) -->
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#262930" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#343842" />
                </shape>
            </item>
            <!-- حالت فعال (تکرنگ آبی کبالت یکدست و شیک) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2563EB" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#4B83F2" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
