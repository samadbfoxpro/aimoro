<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">

    <ImageView
        android:id="@+id/ivCapturedThumb"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_edit_text"
        android:scaleType="centerCrop"
        android:contentDescription="Captured Image" />

    <TextView
        android:id="@+id/tvCapturedDimension"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/ivCapturedThumb"
        android:layout_alignStart="@id/ivCapturedThumb"
        android:layout_alignEnd="@id/ivCapturedThumb"
        android:background="#AA000000"
        android:gravity="center"
        android:paddingVertical="1dp"
        android:text="512×512"
        android:textColor="@color/white"
        android:textSize="9sp" />

    <!-- Remove image button -->
    <ImageButton
        android:id="@+id/btnRemoveImage"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignTop="@id/ivCapturedThumb"
        android:layout_alignEnd="@id/ivCapturedThumb"
        android:layout_margin="2dp"
        android:background="@drawable/bg_badge_profile"
        android:contentDescription="Remove"
        android:padding="4dp"
        android:src="@drawable/ic_close" />

</RelativeLayout>
